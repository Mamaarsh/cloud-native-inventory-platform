DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SECRET_KEY=local-only-change-this-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False
# Public defaults keep the Compose quick start independent from the lab Nexus.
# Lab override example: 192.168.122.1:8083
NEXUS_DOCKER_GROUP=docker.io/library
# The unprivileged image is outside Docker Hub's library namespace.
# Lab override example: 192.168.122.1:8083/nginxinc/nginx-unprivileged:alpine
NGINX_BASE_IMAGE=docker.io/nginxinc/nginx-unprivileged:alpine
FRONTEND_PORT=8080
